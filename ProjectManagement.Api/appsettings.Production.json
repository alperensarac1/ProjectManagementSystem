{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/app/data/projectmanagement.db;Foreign Keys=True"
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Jwt": {
    "Issuer": "ProjectManagement.Api",
    "Audience": "ProjectManagement.Client",
    "SecretKey": "",
    "ExpirationMinutes": 30
  },

  "RefreshToken": {
    "ExpirationDays": 14,
    "MaximumActiveTokensPerUser": 5
  },

  "InitialAdmin": {
    "Enabled": false,
    "FirstName": "System",
    "LastName": "Administrator",
    "Email": "",
    "Department": "Bilgi İşlem"
  },
  "DatabaseBackup": {
    "Enabled": true,
    "IntervalMinutes": 10,
    "RunOnStartup": true,
    "BackupDirectory": "/app/backups",
    "RetentionDays": 7,
    "ValidateBackup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "AllowedHosts": "*"
}