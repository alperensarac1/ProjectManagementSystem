{

  "ConnectionStrings": {
    "DefaultConnection": "Data Source=projectmanagement.db;Foreign Keys=True"
  },
  "MailboxStorage": {
    "RootDirectory": "uploads/mailbox",
    "RetentionMonths": 1,
    "CleanupIntervalHours": 6,
    "CleanupEnabled": true
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8081"
    ]
  },

  "Jwt": {
    "Issuer": "ProjectManagement.Api",
    "Audience": "ProjectManagement.Client",
    "SecretKey": "ProjectManagement-Development-Secret-Key-2026",
    "ExpirationMinutes": 60
  },
  "RefreshToken": {
    "ExpirationDays": 14,
    "MaximumActiveTokensPerUser": 5
  },

  "DatabaseBackup": {
    "Enabled": true,
    "IntervalMinutes": 10,
    "RunOnStartup": true,
    "BackupDirectory": "backups",
    "RetentionDays": 7,
    "ValidateBackup": true
  },
  "InitialAdmin": {
    "Enabled": true,
    "FirstName": "System",
    "LastName": "Administrator",
    "Email": "admin@projectmanagement.local",
    "Department": "Bilgi İşlem"
  },
  

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
 

  "AllowedHosts": "*"
}